# Variables d'environnement lues par l'assistance IA (chantier `ia`).
# Copier ce fichier en `.env` (jamais suivi par Git, voir .gitignore) et
# renseigner les valeurs réelles. Aucune clé n'est requise pour utiliser
# uniquement le backend local Ollama.

# Nom du modèle chargé dans Ollama (http://localhost:11434), ex. mistral-small3.2
OLLAMA_MODEL=

# Clé API Gemini (Google AI Studio, palier gratuit) — backend distant privilégié
GEMINI_API_KEY=

# Clé API Groq (palier gratuit) — backend distant de secours
GROQ_API_KEY=

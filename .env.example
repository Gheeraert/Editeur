# Variables d'environnement utilisees par l'interface graphique (gui.py) pour
# preremplir les champs de l'assistance IA (chantier `ia`) - simple confort,
# jamais un mode preselectionne : les champs restent visibles et modifiables,
# et le choix du mode (Desactivee/Locale/Distante) reste toujours explicite a
# chaque lancement.
#
# L'outil ne lit pas de fichier .env automatiquement : ce fichier documente
# seulement les noms de variables attendus. Definir ces variables dans
# l'environnement avant de lancer main.py (ex. $env:GEMINI_API_KEY = "..." en
# PowerShell). Aucune cle n'est requise pour utiliser uniquement le backend
# local Ollama.

# Nom du modèle chargé dans Ollama (http://localhost:11434), ex. mistral-small3.2
OLLAMA_MODEL=

# Clé API Gemini (Google AI Studio, palier gratuit) — backend distant privilégié
GEMINI_API_KEY=

# Clé API Groq (palier gratuit) — backend distant de secours
GROQ_API_KEY=
